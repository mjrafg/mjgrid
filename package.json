{
  "name": "@agent24/mjgrid",
  "version": "1.4.1",
  "description": "Declarative CRUD grid: one column definition drives the grid, filter bar, create/edit form, inline editing and Excel export. Headless core + MUI adapter.",
  "license": "MIT",
  "author": "mjrafg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjrafg/mjgrid.git"
  },
  "homepage": "https://github.com/mjrafg/mjgrid#readme",
  "bugs": {
    "url": "https://github.com/mjrafg/mjgrid/issues"
  },
  "keywords": [
    "react",
    "grid",
    "datagrid",
    "crud",
    "mui",
    "tanstack-table",
    "tanstack-query",
    "excel",
    "headless"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./mui": {
      "types": "./dist/mui/index.d.ts",
      "import": "./dist/mui/index.js",
      "require": "./dist/mui/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:esm",
    "check:esm": "node scripts/check-esm.mjs",
    "test:matrix": "sh scripts/test-matrix.sh 5.12.2 18.2.0"
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@mui/material": ">=5.12 <10",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "@mui/material": {
      "optional": true
    },
    "@emotion/react": {
      "optional": true
    },
    "@emotion/styled": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^9.2.4",
    "dayjs": "^1.11.13",
    "react-hook-form": "^7.53.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@eslint/js": "^10.0.1",
    "@mui/material": "^9.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
